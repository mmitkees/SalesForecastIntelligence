# Database Configuration
# Default: Local SQLite (No change needed)
DATABASE_URL=sqlite:///sales_app_v3.db

# Server Configuration
PORT=8888

# ==============================================================================
# Remote Deployment Configuration (used by remote_deploy.sh)
# ==============================================================================
# Server IP address for remote deployment
REMOTE_SERVER_IP=129.151.159.172

# SSH user on the remote server (default: opc for Oracle Cloud)
REMOTE_SERVER_USER=opc

# Path to SSH private key (relative to project root or absolute)
SSH_KEY_PATH=serverkeys/ssh-key-2026-01-13.key

# Directory on remote server where app will be deployed
REMOTE_APP_DIR=/home/opc/sales-app

# Git Repository Configuration
GIT_REPO_URL=https://github.com/mmitkees/SalesForecastIntelligence.git
GIT_BRANCH=dev
